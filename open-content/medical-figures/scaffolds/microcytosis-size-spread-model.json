  "sourceFacts": [
    {
      "id": "fact-1",
      "fact": "MCV classifies cells by mean volume; microcytosis means low average volume.",
      "sources": [
        {
          "title": "MedlinePlus: RDW test",
          "url": "https://medlineplus.gov/lab-tests/rdw-red-cell-distribution-width/"
        },
        {
          "title": "RCH: Anaemia guideline",
          "url": "https://www.rch.org.au/clinicalguide/guideline_index/Anaemia_Guideline/"
        }
      ]
    },
    {
      "id": "fact-2",
      "fact": "RDW reflects the variability of red-cell size and can be normal despite small average size.",
      "sources": [
        {
          "title": "MedlinePlus: RDW test",
          "url": "https://medlineplus.gov/lab-tests/rdw-red-cell-distribution-width/"
        },
        {
          "title": "RCH: Anaemia guideline",
          "url": "https://www.rch.org.au/clinicalguide/guideline_index/Anaemia_Guideline/"
        }
      ]
    },
    {
      "id": "fact-3",
      "fact": "Beta-thalassaemia trait commonly has microcytosis with an often normal RDW.",
      "sources": [
        {
          "title": "MedlinePlus: RDW test",
          "url": "https://medlineplus.gov/lab-tests/rdw-red-cell-distribution-width/"
        },
        {
          "title": "RCH: Anaemia guideline",
          "url": "https://www.rch.org.au/clinicalguide/guideline_index/Anaemia_Guideline/"
        }
      ]
    }
