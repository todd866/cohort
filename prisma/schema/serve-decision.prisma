// =============================================================================
// SERVE DECISION TRACE
// Per-item "why this item?" record. Each live pathway (manifold, starter,
// rereview, instant, focused) writes a ServeDecision row when an item is
// returned. Background cache builds write rows with deliveryPath = null;
// cache delivery either UPDATEs the matching row in-session or INSERTs a
// child row cross-session (parentDecisionId).
// See docs/superpowers/specs/2026-05-08-serve-decision-trace-design.md
// =============================================================================

model ServeDecision {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  batchId   String?
  itemType  String // card | question | video | group
  itemId    String
  rotation  String?
  week      Int?

  decidedAt  DateTime  @default(now()) @db.Timestamptz(3)
  exposedAt  DateTime? @db.Timestamptz(3)
  answeredAt DateTime? @db.Timestamptz(3)

  decisionPath String? // manifold-walk | starter | rereview | instant | focused | scaffold | cache-refresh
  deliveryPath String? // null | 'live' | 'cached'

  queueReason     String?
  position        Int?
  rankInPool      Int?
  poolSize        Int?
  priority        Float?
  predictedRecall Float? // Pre-serve item outcome proxy; calibration must be checked against observed grades
  difficultyTier  String?
  conceptId       String?
  clusterId       String?
  variantGroupId  String?
  variantIndex    Int?
  variantType     String?

  isCorrect      Boolean?
  quality        Int?
  responseTimeMs Int?

  // The ARRANGEMENT the learner was shown, recorded at serve time.
  //
  // QuestionResponse.correctDisplayPosition only exists once an item is
  // ANSWERED, so a question that was shown and skipped left no record of where
  // its answer sat — and any claim about option-position bias was measured on a
  // population filtered by the learner's own behaviour. These two columns make
  // the served distribution observable independently of whether anyone replied.
  // Null for cards, videos, and any question served before this shipped.
  servedCorrectPosition Int? // 0-indexed position of the correct option as delivered
  servedOptionCount     Int? // how many options were delivered (4 and 5 both occur)

  parentDecisionId String?
  summary          String
  payload          Json?   @db.JsonB

  // Immutable exam-target decision provenance. These fields are nullable so
  // pre-v2 history remains valid; treatment writes populate the full typed
  // trace rather than overloading payload/rankInPool.
  decisionSetId String?
  decisionSet   SchedulerDecisionSet? @relation(fields: [decisionSetId], references: [id], onDelete: SetNull)

  examTargetSnapshotId String?
  targetRotation       String?
  examTargetSnapshot   ExamTargetSnapshot? @relation(fields: [examTargetSnapshotId, targetRotation], references: [id, rotation], onDelete: Restrict)

  schedulerVersion         String?
  targetPolicyVersion      String?
  targetMode               String?
  targetAssignment         String?
  targetId                 String?
  targetRevision           Int?
  targetBasis              String?
  targetScorerVersion      String?
  targetEmbeddingHash      String?
  targetActivationRevision Int?
  sourceRotation           String?
  slotClass                String?
  targetEligible           Boolean?
  targetApplied            Boolean?
  targetBypassReason       String?
  targetDomainCode         String?
  targetPressureBucket     String?
  examRelevancePct         Float?
  examDomainWeight         Float?
  userDomainGap            Float?
  contentTargetScore       Float?
  personalizedTargetScore  Float?
  targetWeightProvenance   String?
  targetBoostDelta         Float?
  baseRankInPool           Int?
  targetRankInPool         Int?
  finalRankInPool          Int?
  targetChangedMembership  Boolean?
  targetCacheAgeMs         Int?
  targetTraceVersion       Int?
  targetTrace              Json?    @db.JsonB

  @@index([userId, itemType, itemId, decidedAt])
  @@index([userId, sessionId, position])
  @@index([sessionId])
  @@index([parentDecisionId])
  // Supports the nightly retention prune (DELETE WHERE decidedAt < cutoff).
  @@index([decidedAt])
  @@index([decisionSetId])
  @@index([examTargetSnapshotId, decidedAt])
  @@index([targetRotation, targetDomainCode, decidedAt])
}
