{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MD3 anatomy annotation specification",
  "description": "Labels and reviewed region masks over an unchanged PNG. Runtime geometry, image integrity and filesystem checks are required in addition to this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "baseImage", "regions", "labels"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "baseImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "width", "height", "review"],
      "properties": {
        "file": { "allOf": [{ "$ref": "#/$defs/relativePath" }, { "pattern": "\\.png$" }] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "polygon", "sources", "review"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/text" },
          "polygon": {
            "type": "array",
            "minItems": 3,
            "items": { "$ref": "#/$defs/point" },
            "description": "Implicitly closed simple polygon with at least three unique vertices. Runtime checks reject self-intersection, degenerate edges and adjacent backtracking."
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "fact"],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^\\s/@?#\\\\]+(?:[/?#][^\\s\\\\]*)?$",
                  "description": "Absolute HTTPS URL without credentials or whitespace. Runtime URL parsing is authoritative."
                },
                "fact": { "$ref": "#/$defs/text" }
              }
            }
          },
          "review": { "$ref": "#/$defs/review" }
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "anchor", "elbow", "textPosition", "targetRegion"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "text": { "$ref": "#/$defs/text" },
          "anchor": { "$ref": "#/$defs/point" },
          "elbow": { "$ref": "#/$defs/point" },
          "textPosition": { "$ref": "#/$defs/point" },
          "targetRegion": { "$ref": "#/$defs/id" },
          "align": { "$ref": "#/$defs/align" },
          "fontSize": { "$ref": "#/$defs/fontSize" }
        }
      }
    },
    "title": { "$ref": "#/$defs/positionedText" },
    "footer": { "$ref": "#/$defs/positionedText" },
    "textBlocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/positionedText" },
      "description": "Panel titles or orientation markers in canvas coordinates. These are positioned text, not region annotations, and have no targetRegion."
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$",
      "description": "Path relative to the explicit root; no absolute paths, dot segments, backslashes, control characters or empty components. Runtime also rejects symlinks and non-regular files."
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": 0 },
      "description": "Finite [x,y] in natural PNG pixels, origin at top left. Runtime also requires x <= width and y <= height."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": { "enum": ["draft", "agent-reviewed"] },
        "notes": { "$ref": "#/$defs/text" }
      },
      "description": "Draft records may be authored and schema-checked, but the renderer requires agent-reviewed for the base image and every region. Agent review is not clinician approval."
    },
    "align": { "enum": ["start", "middle", "end"] },
    "fontSize": { "type": "number", "exclusiveMinimum": 0 },
    "positionedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "position"],
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "position": { "$ref": "#/$defs/point" },
        "align": { "$ref": "#/$defs/align" },
        "fontSize": { "$ref": "#/$defs/fontSize" }
      }
    }
  }
}
