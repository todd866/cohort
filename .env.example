# ── Required ──────────────────────────────────────────────
# PostgreSQL connection used by the application and Prisma.
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"
# Direct, non-pooler Neon endpoint. Required only for reviewed production
# migrations and their read-only verification; application traffic uses the
# pooled DATABASE_URL above.
DATABASE_URL_UNPOOLED="postgresql://username:password@direct-host:5432/database?sslmode=require"
# Generate a unique value, for example: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Auth ─────────────────────────────────────────────────
# Leave AUTH_URL and NEXTAUTH_URL unset when one deployment serves more than
# one hostname (as md3.info + cohort.md do). Auth.js then uses the trusted
# request host for OAuth callbacks, email links, redirects, and host-only
# cookies. A single-host fork may set AUTH_URL to its one public HTTPS origin.
# AUTH_URL="https://learn.example.org"
# Set true only for the canonical deployment that intentionally serves both
# exact md3.info and cohort.md hosts. Self-hosted forks should leave this false
# and configure their own HTTPS AUTH_URL instead.
AUTH_TRUST_MD3_COHORT_HOSTS="false"
# For each enabled OAuth provider on the shared deployment, register both:
# https://md3.info/api/auth/callback/<provider>
# https://cohort.md/api/auth/callback/<provider>
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
# Email sign-in and alias verification remain disabled unless both values are set.
# Use a sender identity controlled and verified by this deployment's operator.
RESEND_API_KEY=""
EMAIL_FROM=""
# Required for the account used to access the currently admin-gated USMLE alpha.
ADMIN_EMAILS=""
# Optional public source CTA shown only after a repository is actually published.
NEXT_PUBLIC_SOURCE_REPOSITORY_URL=""
# Optional third-party analytics. Disabled unless explicitly set to true.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS="false"

# Optional local PaperScope bridge. Requests with
# Authorization: Bearer $MD3_PAPERSCOPE_TOKEN are recorded as this user.
MD3_PAPERSCOPE_TOKEN=""
MD3_PAPERSCOPE_USER_EMAIL=""
MD3_PAPERSCOPE_USER_ID=""

# ── AI Keys ──────────────────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# ── Storage (Cloudflare R2) ──────────────────────────────
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_ENDPOINT=""
CLOUDFLARE_API_TOKEN=""
# Optional public media bucket. Never store user-selected documents here.
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_URL=""
# Dedicated private video bucket with no r2.dev/custom public domain. Learner
# delivery uses 15-minute signed URLs so retained links expire after revocation.
CLOUDFLARE_R2_VIDEO_BUCKET_NAME=""
# Dedicated private bucket with no r2.dev/custom public domain. The app fails
# closed if this is missing or equals CLOUDFLARE_R2_BUCKET_NAME.
CLOUDFLARE_R2_USER_DOCUMENTS_BUCKET_NAME=""
CONTENT_BLOB_BASE_URL=""
BLOB_READ_WRITE_TOKEN=""

# ── Vector Search (Qdrant) ───────────────────────────────
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="md3"

# ── Cron / Scheduling ───────────────────────────────────
CRON_SECRET=""
# Optional HTTPS receiver for privacy-safe hard-failure pages from cron probes.
# When absent, alerts use RESEND_API_KEY + EMAIL_FROM + ADMIN_EMAILS.
OPS_ALERT_WEBHOOK_URL=""
OPS_ALERT_WEBHOOK_TOKEN=""

# ── Content & Data ──────────────────────────────────────
CONTENT_LAKE_PATH=""
CALIBRATION_PATH=""
QUESTION_BANK_BATCH_SIZE=""
LOG_LEVEL="info"

# ── Access Control ─────────────────────────────────────
VIDEO_ACCESS_EMAILS=""

# ── Figures R2 bucket (private, accessed via signed URLs) ──
R2_FIGURES_BUCKET=""
R2_FIGURES_ENDPOINT=""
R2_FIGURES_ACCESS_KEY_ID=""
R2_FIGURES_SECRET_ACCESS_KEY=""
# Flip to "true" to serve /figures/* via signed R2 URLs. Off until Phase 2b cutover.
FIGURES_USE_R2_SIGNED_URLS=false
